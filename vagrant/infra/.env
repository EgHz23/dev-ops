# ===== Local authentication & admin user =====
LOCAL_AUTH_ENABLED=1

# JWT settings for local auth
LOCAL_JWT_SECRET=2d97digtHFxFXf_alZHEtT13FiAFyJdPBlpHolsgAZ-qEVUh2jilr5q8nOV7C1mXxSJ8gOFQywP_YABME6pRXw
LOCAL_JWT_ISSUER=local
LOCAL_JWT_AUDIENCE=local

# Initial local admin identity
LOCAL_ADMIN_USERNAME=admin
# Leave empty if you only use the hash
LOCAL_ADMIN_PASSWORD=

# IMPORTANT: escape $ as $$ so Docker Compose doesn't try to expand them
LOCAL_ADMIN_PASSWORD_HASH=$$bcrypt-sha256$$v=2,t=2b,r=12$$96spoT6WNLmftTGaBcHsP.$$mT0UXrgI8O84jFs73k0DixX3MzeHRTG

LOCAL_ADMIN_EMAIL=admin@example.com
LOCAL_ADMIN_NAME=Local Admin

# ===== Cryptographic keys =====
# Used by the app for encrypting sensitive data (e.g. stored secrets)
FERNET_KEY=Y5uVfDDgW2ZjxFMuzyfzBfhBHefljEtKu3nR6bcMUuI=

# ===== CORS / Proxy =====
# Comma-separated list of allowed origins for the frontend
CORS_ORIGINS=http://localhost,http://127.0.0.1

# Comma-separated list of hosts trusted by the backend when behind nginx
PROXY_TRUSTED_HOSTS=*
